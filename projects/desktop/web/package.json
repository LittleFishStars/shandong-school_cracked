{
  "name": "shandong-school-cracked-web",
  "private": true,
  "version": "1.2.0",
  "scripts": {
    "build": "npm run lint --silent && esbuild src/main.jsx --bundle --minify --format=iife --target=es2018 --loader:.js=jsx --outfile=app.bundle.js",
    "lint": "eslint src && python3 ../../scripts/web_lint.py src"
  },
  "dependencies": {
    "antd": "4.24.16",
    "dayjs": "^1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3"
  }
}
